# ====================================================================
# DijitalAtolye - Production self-hosted .env.prod
# Bu dosyayi `.env.prod` olarak kopyalayin ve TUM SECRET'lari doldurun.
# Asla repoya commit ETMEYIN. Permission: chmod 600 .env.prod
# Calistirma:
#   docker compose -f deploy/docker-compose/docker-compose.prod.yml --env-file .env.prod up -d --build
# Hizli secret uretimi:
#   for k in POSTGRES_PASSWORD MONGO_PASSWORD REDIS_PASSWORD RABBITMQ_PASSWORD MINIO_ROOT_PASSWORD; do \
#     echo "$k=$(openssl rand -hex 24)"; done
#   echo "JWT_SIGNING_KEY=$(openssl rand -hex 48)"
# ====================================================================

# === Public ayarlar ===
# Lokal test icin 'localhost' birakin (Caddy internal CA ile self-signed cert verir).
# Gercek deploy icin: ornek.com
PUBLIC_DOMAIN=localhost
# ACME_EMAIL='internal' verilirse Caddy local CA kullanir; gercek domain icin gercek e-posta
ACME_EMAIL=internal
TZ=Europe/Istanbul
IMAGE_TAG=latest

# CORS — birden fazla origin: virgulle
CORS_ORIGINS=https://localhost

# === PostgreSQL ===
POSTGRES_USER=dijitalatolye
POSTGRES_PASSWORD=                  # ZORUNLU — openssl rand -hex 24

# === MongoDB ===
MONGO_USER=dijitalatolye
MONGO_PASSWORD=                     # ZORUNLU

# === Redis ===
REDIS_PASSWORD=                     # ZORUNLU

# === RabbitMQ ===
RABBITMQ_USER=dijitalatolye
RABBITMQ_PASSWORD=                  # ZORUNLU

# === MinIO (S3-compatible object storage) ===
MINIO_ROOT_USER=dijitalatolye
MINIO_ROOT_PASSWORD=                # ZORUNLU (minimum 8 karakter)
MINIO_BUCKET_CONTENT=dijitalatolye-content
MINIO_BUCKET_PUBLISHED=dijitalatolye-content-published
MINIO_BUCKET_AVATARS=dijitalatolye-avatars
# Tarayicilara dondurulen public URL (presigned/static); Caddy /cdn/* path'i ile proxy'lenir
MINIO_PUBLIC_ENDPOINT=https://localhost/cdn

# === Identity / JWT ===
JWT_AUDIENCE=dijitalatolye-api
JWT_SIGNING_KEY=                    # ZORUNLU — minimum 32 karakter (openssl rand -hex 48 onerilir)
JWT_ACCESS_LIFETIME=01:00:00
JWT_REFRESH_LIFETIME=14.00:00:00

# === Google OAuth (opsiyonel — bos birakilirsa social login devre disi) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === LLM Sağlayıcıları ===
# Birincil saglayici: deepseek | gemini | anthropic
AIMODERATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === SMTP (uretimde GERCEK SMTP kullanin) ===
# Lokalde test icin: SMTP_HOST=mailhog SMTP_PORT=1025 SMTP_USE_SSL=false ve
# `--profile mailhog` ile compose'u baslatin (http://localhost:8025 UI).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dijitalatolye.local
SMTP_FROM_NAME=DijitalAtolye

# === Observability (production checklist) ===
# Zorunlu önerilen: SENTRY_DSN (self-hosted: docs/runbooks/self-hosted-sentry.md)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# OTLP collector (--profile observability ile):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=
# AI günlük maliyet limiti (USD)
AIMODERATION_COST_CAP_USD_PER_DAY=50

# Web Push (VAPID) — `npx web-push generate-vapid-keys` ile üretin
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com
