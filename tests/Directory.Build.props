<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!-- Testlerde `string?` gibi açıklamalar kullanılıyor; CI /warnaserror ile derlediği için CS8632 hata olurdu.
         annotations: açıklamalara izin verir, null-akış uyarılarını testlerde açmaz. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
