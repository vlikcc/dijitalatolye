{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*",
  "Cors": { "Origins": "http://localhost:5173,http://localhost:3000" },
  "Jwt": { "Authority": "http://localhost:5001", "Audience": "dijitalatolye-api", "RequireHttpsMetadata": false },
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://localhost:5000" } } },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "RateLimiterPolicy": "auth-strict",
        "Transforms": [ { "PathPattern": "/auth/{**catch-all}" } ]
      },
      "users": {
        "ClusterId": "user",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/users/{**catch-all}" } ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/catalog/{**catch-all}" } ]
      },
      "storage": {
        "ClusterId": "storage",
        "Match": { "Path": "/api/storage/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "RateLimiterPolicy": "upload",
        "Transforms": [ { "PathPattern": "/storage/{**catch-all}" } ]
      },
      "contents-play": {
        "ClusterId": "content",
        "Match": { "Path": "/api/contents/by-slug/{slug}/play" },
        "AuthorizationPolicy": "Anonymous",
        "Transforms": [ { "PathPattern": "/contents/by-slug/{slug}/play" } ]
      },
      "contents": {
        "ClusterId": "content",
        "Match": { "Path": "/api/contents/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/contents/{**catch-all}" } ]
      },
      "review": {
        "ClusterId": "review",
        "Match": { "Path": "/api/review/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/review/{**catch-all}" } ]
      },
      "moderation": {
        "ClusterId": "aimoderation",
        "Match": { "Path": "/api/moderation/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/moderation/{**catch-all}" } ]
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/notifications/{**catch-all}" } ]
      },
      "notifications-hub": {
        "ClusterId": "notification",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/analytics/{**catch-all}" } ]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/search/{**catch-all}" } ]
      },
      "admin-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/users/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/admin/users/{**catch-all}" } ]
      },
      "admin": {
        "ClusterId": "admin",
        "Match": { "Path": "/api/admin/{**catch-all}" },
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Transforms": [ { "PathPattern": "/admin/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5001" } } },
      "user": { "Destinations": { "primary": { "Address": "http://localhost:5002" } } },
      "catalog": { "Destinations": { "primary": { "Address": "http://localhost:5003" } } },
      "storage": { "Destinations": { "primary": { "Address": "http://localhost:5004" } } },
      "content": { "Destinations": { "primary": { "Address": "http://localhost:5005" } } },
      "aimoderation": { "Destinations": { "primary": { "Address": "http://localhost:5006" } } },
      "review": { "Destinations": { "primary": { "Address": "http://localhost:5007" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://localhost:5008" } } },
      "analytics": { "Destinations": { "primary": { "Address": "http://localhost:5109" } } },
      "search": { "Destinations": { "primary": { "Address": "http://localhost:5110" } } },
      "admin": { "Destinations": { "primary": { "Address": "http://localhost:5111" } } }
    }
  }
}
