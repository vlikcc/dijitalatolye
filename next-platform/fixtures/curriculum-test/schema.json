      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "pdfPage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "printedPage": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "sourceId",
        "pdfPage",
        "printedPage",
        "section",
        "anchor"
      ],
      "additionalProperties": false
