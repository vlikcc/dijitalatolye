        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentType": {
          "enum": [
            "curriculum_pdf",
            "directory_html",
            "program_detail_html",
            "board_decision_pdf",
            "implementation_pdf",
            "official_web_page",
            "other"
          ]
        },
        "publicationDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "accessStatus": {
          "enum": [
            "downloaded",
            "read_via_web",
            "inaccessible",
            "not_attempted"
