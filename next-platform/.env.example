APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app:local-only@127.0.0.1:55432/dijital
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-different-random-secret
INTERNAL_SECRET=replace-with-another-random-secret
DATA_DIR=.data
GAME_BASE_DOMAIN=games.localhost
GAME_PROTOCOL=http
GAME_PORT=58080
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
YARA_BIN=yara
YARA_RULES=deploy/security.yar
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
MAIL_FROM=DijitalAtölye <noreply@example.test>
SMTP_USER=
SMTP_PASSWORD=

# Bundled playable examples. Explicit opt-in, including team previews.
DEMO_CATALOG_ENABLED=false

# Student accounts, classes, assignments and game checkpoints (pilot opt-in).
STUDENT_LEARNING_ENABLED=false

# Single-domain team preview: disables uploads and uploaded game delivery.
# Use deploy/compose.demo.yml for the doa.gorkem.io preview.
BUNDLED_DEMO_ONLY=false
