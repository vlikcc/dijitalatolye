      "description": "Visible label and white editable control with the common focus outline.",
      "html": "<label class=\"ds-field\">Oyun başlığı<input class=\"ds-field-input\" placeholder=\"Başlığı yazın\"></label>",
      "css": ".ds-field{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);display:grid;gap:7px;color:var(--foreground,#24344d);font-size:15px;font-weight:600;}.ds-field-input{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);width:100%;min-width:0;min-height:46px;padding:11px 12px;border:1px solid var(--input-border,#8a94a4);border-radius:7px;background:var(--surface,#fff);color:var(--foreground,#24344d);font-size:16px;font-weight:400;line-height:1.55;caret-color:var(--primary,#24344d);}.ds-field-input::placeholder{color:var(--muted,#606a79);}.ds-field-input:hover{border-color:var(--input-border,#8a94a4);}.ds-field-input:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}"
    },
    {
      "name": "Shared navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Discovery links use the same selected fill and 44px minimum targets as workspace navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Oyunlar\"><a class=\"ds-nav-link\" href=\"#oyunlar\" aria-current=\"page\">Oyunlar</a><a class=\"ds-nav-link\" href=\"#kaydedilenler\">Kaydettiklerim</a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);display:flex;flex-wrap:wrap;gap:4px;font-size:15px;font-weight:600;}.ds-nav-link{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:9px 14px;border-radius:8px;color:var(--foreground,#24344d);text-decoration:none;transition:background-color 180ms ease,color 180ms ease;}.ds-nav-link:hover,.ds-nav-link[aria-current=\"page\"]{color:var(--primary,#24344d);background:var(--interactive-hover,#e8edf4);}.ds-nav-link:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none;}}"
    },
    {
      "name": "Subject tag",
      "kind": "chip",
      "refersTo": "subject-tag",
      "description": "Mathematics metadata keeps the established subject colour; it is not a global action colour.",
      "html": "<a class=\"ds-subject-tag\" href=\"#matematik\">Matematik</a>",
      "css": ".ds-subject-tag{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);display:inline-flex;align-items:center;gap:8px;padding:4px 10px;border-radius:5px;background:var(--subject-bg,#eee7fc);color:var(--subject,#7046d3);font-size:14px;line-height:1.55;font-weight:600;text-decoration:none;}.ds-subject-tag:hover{text-decoration:underline;}.ds-subject-tag:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}"
    },
    {
      "name": "Game card content",
      "kind": "card",
      "refersTo": "game-card",
      "description": "The flat white content frame; production cards add their real game artwork above this region.",
      "html": "<article class=\"ds-game-card\"><div class=\"ds-card-meta\"><span class=\"ds-card-subject\">Matematik</span><span>3. sınıf</span></div><h3 class=\"ds-card-title\"><a class=\"ds-card-link\" href=\"#oyun\">Örnek oyun</a></h3><p class=\"ds-card-copy\">Kısa bir etkinlikle öğrendiklerini dene.</p><span class=\"ds-card-demo\">Demo</span></article>",
      "css": ".ds-game-card{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);background:var(--surface,#fff);color:var(--foreground,#24344d);border:1px solid var(--border,#dde2e8);border-radius:14px;padding:16px 17px 13px;max-width:300px;}.ds-card-meta{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--muted,#606a79);margin-bottom:8px;}.ds-card-subject{color:var(--subject,#7046d3);font-weight:600;}.ds-card-title{font-family:var(--font-display,\"Manrope Variable\",sans-serif);font-size:18px;font-weight:750;line-height:1.35;letter-spacing:-.025em;margin:0;}.ds-card-link{color:inherit;text-decoration:none;}.ds-game-card:hover .ds-card-link{color:var(--subject,#7046d3);}.ds-card-link:hover{text-decoration:underline;}.ds-card-link:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}.ds-card-copy{font-size:14px;line-height:1.55;color:var(--muted,#606a79);margin:7px 0 14px;}.ds-card-demo{display:inline-block;font-size:11px;color:var(--muted,#606a79);border:1px solid var(--border,#dde2e8);border-radius:4px;padding:1px 6px;}"
    },
    {
      "name": "Account type tabs",
      "kind": "custom",
      "refersTo": "account-tabs",
      "description": "Static style preview of teacher/student tabs; production RegisterForm supplies roving focus and mounted panels.",
      "html": "<div class=\"ds-account-tabs\" role=\"tablist\" aria-label=\"Hesap türü\"><button class=\"ds-account-tab\" role=\"tab\" aria-selected=\"true\">Öğretmen</button><button class=\"ds-account-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Öğrenci</button></div>",
      "css": ".ds-account-tabs{display:flex;padding:4px;background:var(--interactive-hover,#e8edf4);border-radius:10px;max-width:480px;}.ds-account-tab{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);flex:1;border:0;min-height:44px;border-radius:7px;background:transparent;color:var(--muted,#606a79);font-size:17px;line-height:1.55;font-weight:600;cursor:pointer;}.ds-account-tab[aria-selected=\"true\"]{background:var(--surface,#fff);color:var(--primary,#24344d);}.ds-account-tab:hover{color:var(--primary,#24344d);}.ds-account-tab:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}"
    },
    {
      "name": "Page heading",
      "kind": "custom",
      "refersTo": "page-heading",
      "description": "Compact task heading and supporting text shared by game and workspace compositions.",
      "html": "<header class=\"ds-page-heading\"><h1 class=\"ds-heading-title\">İçeriklerim</h1><p class=\"ds-heading-copy\">Oyunlarını ve inceleme durumlarını gör.</p></header>",
      "css": ".ds-page-heading{color:var(--foreground,#24344d);margin:32px 0 28px;}.ds-heading-title{font-family:var(--font-display,\"Manrope Variable\",sans-serif);font-size:32px;font-weight:750;line-height:1.25;letter-spacing:-.03em;margin:0;overflow-wrap:anywhere;}.ds-heading-copy{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);font-size:16px;line-height:1.55;color:var(--muted,#606a79);margin:8px 0 0;max-width:72ch;}@media(max-width:600px){.ds-heading-title{font-size:28px;}.ds-page-heading{margin:24px 0;}}"
    }
  ],
  "narrative": {
    "northStar": "Keşif Atlası",
    "overview": "Keşif Atlası is a bright, orderly workshop for finding, playing and managing short learning games. Neutral paper and navy ink now form one host interface across public discovery, game detail, accounts and every role workspace. White controls, real game scenes and written subject labels keep the next task visible.\n\nManrope gives headings and the live wordmark a clear, confident shape; Source Sans 3 keeps Turkish controls and explanations readable. The original four-piece circular puzzle mark remains the signature. Paper texture belongs to discovery, game detail and account introductions; operational workspaces stay flat. The host is light-only, including its short footer. Individual game documents retain their own content colours and layout.",
    "keyCharacteristics": [
      "One neutral ground, navy text and actions, white controls, and unchanged subject colour pairs across the host application.",
      "Locally served Manrope headings and brand lettering, with Source Sans 3 interface text and Turkish characters.",
      "Compact page headings, restrained game tools, flat task lists and selected workspace sections.",
      "Real game art, explicit Demo labels and the original puzzle signature with reduced-motion support.",
      "Visible keyboard focus, labelled navigation, preserved form drafts and responsive 4/2/1 catalogue columns."
    ],
    "rules": [
      {
        "name": "The Subject Thread Rule",
        "body": "Keep each subject’s colour and written label together across its tab, game card and detail metadata. Colour reinforces the label; it does not replace it.",
        "section": "colors"
      },
      {
        "name": "The Shared Ink Rule",
        "body": "Use the same navy action and focus system in discovery, accounts and workspaces. Violet remains a Mathematics and bundled-game colour, not a second host theme.",
        "section": "colors"
      },
      {
        "name": "The Contained Lift Rule",
        "body": "Keep catalogue cards and workspaces flat at rest. Use the existing soft elevation for overlapping menus, the player start panel and transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared neutral ground and navy controls for all host routes, while preserving subject and game colours.",
      "Do keep the original puzzle mark, once-per-document animation, real game captures and local CC0 paper asset with its provenance.",
      "Do use compact headings, written statuses, native form semantics, visible focus and the same role navigation in the sidebar and mobile menu.",
      "Do preserve mounted account/review panels, single-player continuity and the user’s draft while changing sections.",
      "Do distinguish browser-local bookmarks from account-bound game progress and provide a selectable link when copying fails."
    ],
    "donts": [
      "Don’t restore the superseded lavender/violet host palette, warm discovery palette, decorative puzzle gutters or Source Serif 4 headings.",
      "Don’t replace game scenes with invented covers or present bundled demos as published teacher uploads.",
      "Don’t introduce oversized workspace banners, nested decorative cards, a detail sidebar or a repeated play action.",
      "Don’t use Unicode glyphs or emoji as interface icons; keep the existing inline SVG vocabulary.",
      "Don’t treat preview tonal ramps as shipping tokens, impose host styling on uploaded games, or claim broad accessibility certification from the bounded checks."
    ]
  }
}
