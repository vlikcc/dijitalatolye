      "css": ".ds-button-outline{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:11px 20px;border:1px solid transparent;border-radius:9px;font-size:16px;line-height:1.55;font-weight:600;text-decoration:none;cursor:pointer;transition:background .16s ease,color .16s ease;background:var(--surface,#fff);border-color:var(--outline-border,#dde2e8);color:var(--foreground,#24344d);}.ds-button-outline:hover{background:var(--interactive-hover,#e8edf4);}.ds-button-outline:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}.ds-button-outline:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none;}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared ghost action; 46px minimum height with visible focus.",
      "html": "<button class=\"ds-button-ghost\" type=\"button\">Ayrıntıları göster</button>",
      "css": ".ds-button-ghost{font-family:var(--font-sans,\"Source Sans 3\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:11px 20px;border:1px solid transparent;border-radius:9px;font-size:16px;line-height:1.55;font-weight:600;text-decoration:none;cursor:pointer;transition:background .16s ease,color .16s ease;background:transparent;color:var(--foreground,#24344d);padding-inline:8px;}.ds-button-ghost:hover{background:var(--interactive-hover,#e8edf4);}.ds-button-ghost:focus-visible{outline:3px solid var(--focus-ring,#3b5f8c);outline-offset:4px;}.ds-button-ghost:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none;}}"
    },
    {
      "name": "Destructive button",
