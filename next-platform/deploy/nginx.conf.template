server {
 listen 8080;
 server_name "~^v-(?<version>[a-f0-9-]{36})\.${GAME_BASE_DOMAIN_REGEX}$";
 server_tokens off;
 access_log off;
 # Request paths contain preview capabilities; do not persist error-log URIs either.
 error_log /dev/null;
 # Docker can replace the web container with a different IP during deployment.
 resolver 127.0.0.11 valid=5s ipv6=off;
 resolver_timeout 3s;
 set $authorization_upstream ${WEB_UPSTREAM};
 add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors ${APP_URL}; sandbox allow-scripts allow-same-origin" always;
 add_header X-Content-Type-Options nosniff always;
 add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
 add_header Referrer-Policy no-referrer always;
 add_header Cache-Control "no-store" always;
 add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
 location = /_authorize {
  internal;
  proxy_pass http://$authorization_upstream/api/internal/asset;
  proxy_connect_timeout 3s;
  proxy_read_timeout 10s;
  proxy_pass_request_body off;
  proxy_set_header Content-Length "";
  proxy_set_header X-Internal-Secret "${INTERNAL_SECRET}";
  proxy_set_header X-Game-Host $http_host;
  proxy_set_header X-Original-URI $request_uri;
  proxy_set_header Cookie "";
  proxy_set_header Authorization "";
 }
 location ~ ^/play/(?<asset>.+)$ {
  auth_request /_authorize;
  alias /games/published/$version/$asset;
  disable_symlinks on;
 }
 location ~ ^/session/[^/]+/(?<session_asset>.+)$ {
  auth_request /_authorize;
  alias /games/published/$version/$session_asset;
  disable_symlinks on;
 }
 location ~ ^/preview/[^/]+/(?<preview_asset>.+)$ {
  auth_request /_authorize;
  alias /games/ready/$version/$preview_asset;
  disable_symlinks on;
 }
 location / { return 404; }
}
server { listen 8080 default_server; server_name _; return 404; }
