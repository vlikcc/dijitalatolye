{
  "name": "dijitalatolye-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/with-env.mjs node .next/standalone/server.js",
    "worker": "node scripts/with-env.mjs tsx src/worker/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/with-env.mjs tsx scripts/migrate.ts",
    "seed": "node scripts/with-env.mjs tsx scripts/seed.ts",
    "bootstrap-admin": "node scripts/with-env.mjs tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/with-env.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/with-env.mjs playwright test",
    "test:e2e:learning": "node scripts/with-env.mjs playwright test --config playwright.learning.config.ts",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs",
    "demos:build": "node scripts/embed-demo-fonts.mjs && tsx scripts/build-demo-assets.ts",
    "pilots:build": "tsx scripts/build-learning-pilots.ts",
    "curriculum": "node scripts/with-env.mjs node --import tsx scripts/curriculum.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "better-auth": "1.7.13",
    "busboy": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "nodemailer": "10.2.1",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tldts": "7.4.19",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "1.5.5",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
