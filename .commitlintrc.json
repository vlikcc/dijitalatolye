{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "chore",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "revert"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "identity",
        "user",
        "content",
        "catalog",
        "ai-moderation",
        "review",
        "notification",
        "search",
        "analytics",
        "storage",
        "gateway",
        "web",
        "eventbus",
        "outbox",
        "common",
        "infra",
        "deploy",
        "ci",
        "deps",
        "docs",
        "adr"
      ]
    ],
    "subject-case": [2, "never", ["upper-case", "pascal-case", "start-case"]],
    "subject-empty": [2, "never"],
    "header-max-length": [2, "always", 100]
  }
}
