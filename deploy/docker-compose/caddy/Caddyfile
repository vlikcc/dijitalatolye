{
	# ACME (Let's Encrypt/ZeroSSL) hesap e-postasi — compose'da ZORUNLU (ACME_EMAIL).
	# PUBLIC_DOMAIN=localhost (veya *.localhost / IP) iken Caddy bu adrese bakmadan otomatik
	# olarak kendi internal CA'sindan sertifika verir; ACME'ye hic gidilmez.
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

# Public domain (env'den; lokalde 'localhost')
{$PUBLIC_DOMAIN:localhost} {
	import site.caddy
}
