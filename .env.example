# DijitalAtolye - Lokal gelistirme ortam degiskenleri
# Repoda GIZLI DEGER YOK. Bu dosyayi kopyalayin; `make env` .env yaratir ve
# COMPOSE_DEV_SECRET (Docker stack icin) otomatik ekler.
#
#   cp .env.example .env
#   make env   # .env yoksa olusturur, COMPOSE_DEV_SECRET yoksa uretir

# === Lokal Docker stack (compose) — SIR, repoya hic commit edilmez ===
# Tum Postgres/Mongo/Redis/Rabbit/MinIO sifreleri bu TEK degerle eslesir.
POSTGRES_USER=dijitalatolye
# Asagidaki satir 'make env' ile otomatik eklenir; elle de openssl rand -hex 24 uretin:
# COMPOSE_DEV_SECRET=

# === ASP.NET Core ===
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# === PostgreSQL (host uzerinde dotnet run; sifre .env’deki COMPOSE_DEV_SECRET ile ayni olmali) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === MongoDB (local URL — kullanici/sifre = POSTGRES_USER / COMPOSE_DEV_SECRET) ===
# Ornek: mongodb://dijitalatolye:COMPOSE_DEV_SIR@localhost:27017/aimoderation?authSource=admin
MONGO_CONNECTION_STRING=

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# === Redis (sifre = COMPOSE_DEV_SECRET) ===
# Ornek: localhost:6379,password=COMPOSE_DEV_SIR,abortConnect=false
REDIS_CONNECTION=

# === Elasticsearch ===
ELASTIC_URI=http://localhost:9200

# === MinIO (S3) ===
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Anahtarlar: MINIO_ROOT_USER / COMPOSE_DEV_SECRET (Docker ile ayni)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_CONTENT=dijitalatolye-content
MINIO_BUCKET_PUBLISHED=dijitalatolye-content-published
MINIO_BUCKET_AVATARS=dijitalatolye-avatars

# === Guard (dosya vetting — ghcr.io/gorkemio/guard) ===
# Guard HMAC secret (64 hex). Guard ve Storage.API arasında paylaşılır.
GUARD_HMAC_SECRET=
# Guard → ana site callback imzası (genelde GUARD_HMAC_SECRET ile aynı)
GUARD_MAIN_SITE_HMAC_SECRET=
# Guard Django + Postgres
GUARD_DJANGO_SECRET_KEY=
GUARD_PG_PASSWORD=
# JSON: {"dijitalatolye":"<GUARD_HMAC_SECRET hex>"} — SourceId anahtarı GUARD_SOURCE_ID ile eşleşmeli
GUARD_HMAC_SECRETS=
GUARD_SOURCE_ID=dijitalatolye
GUARD_IMAGE=ghcr.io/gorkemio/guard:sha-77b6b3c@sha256:61161ed4ac85d873b6dc48d2cd4ead77d67c7cd691d653a8c74fed6ce0831391
# Guard yönetim paneli (nginx + React SPA) — lokal: http://localhost:18000
GUARD_HTTP_PORT=18000
GUARD_ALLOWED_HOSTS=guard-web,guard-nginx,localhost,127.0.0.1
GUARD_CSRF_TRUSTED_ORIGINS=http://localhost:18000,http://127.0.0.1:18000
# Guard'ın Storage.API callback base URL'i (compose içi: http://storage:8080)
GUARD_MAIN_SITE_BASE=http://storage:8080

# === SMTP (Mailhog dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dijitalatolye.local

# === Identity / JWT ===
JWT_AUTHORITY=http://localhost:5001
JWT_AUDIENCE=dijitalatolye-api
# En az 32 karakter (Identity JWT). 'make env' otomatik ekler.
JWT_SIGNING_KEY=

# === LLM Providers (ADR-006, ADR-009) ===
# AI moderasyon saglayicisi: evren (EVREN_API_KEY) | deepseek (DEEPSEEK_API_KEY)
AIMODERATION_PROVIDER=evren
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048

# AI Oyun Stüdyosu — EVREN LLM (OpenAI uyumlu). Anahtar: https://evren.ssyz.org.tr/api-keys
# Boş bırakılırsa öğretmenler yalnızca profillerinden ekledikleri kendi anahtarlarıyla üretebilir.
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=qwen3.8-flash-next
# AI moderasyonda sırayla denenen EVREN modelleri (biri 503 verirse sıradakine geçilir)
EVREN_MODERATION_MODELS=deepseek-v4.1-flash,glm-5.3,qwen3.8-flash-next
# Platform anahtarıyla öğretmen başına günlük üretim (tur) sınırı
EVREN_DAILY_GENERATIONS_PER_USER=20

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === Google OAuth (opsiyonel) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# === Frontend (Vite) ===
VITE_API_BASE_URL=http://localhost:5000
VITE_CONTENT_CDN_BASE_URL=http://localhost:9000/dijitalatolye-content-published
